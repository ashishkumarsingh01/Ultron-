# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# API Keys
OPENAI_API_KEY=your-api-key-here
CLAUDE_API_KEY=your-api-key-here
GOOGLE_CLOUD_KEY=your-api-key-here
PINCONE_API_KEY=your-api-key-here

# Memory Configuration
MEMORY_BACKEND=chroma
MEMORY_DIMENSION=1536
PINCONE_INDEX=ultron
MEMORY_RETENTION_DAYS=30

# Interface Configuration
ENABLE_VOICE=true
ENABLE_VISION=true
ENABLE_WEB=true
VOICE_LANGUAGE=en-US

# Control Configuration
ENABLE_COMPUTER_CONTROL=true
ENABLE_ANDROID_CONTROL=true
ENABLE_DEVELOPER_AGENT=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ultron.log
ENABLE_FILE_LOGGING=true

# Agent Configuration
AGENT_NAME=Ultron
AGENT_DESCRIPTION=Advanced AI Agent Kernel